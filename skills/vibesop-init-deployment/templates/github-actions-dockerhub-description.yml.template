# 同步 Docker Hub 仓库描述（README + 短描述）。
#
# 触发方式：{{HUB_README_PATH}} 或本文件变更并推送到主分支；也支持手动触发（workflow_dispatch）。
# 所需 secrets：DOCKERHUB_USERNAME、DOCKERHUB_TOKEN。描述接口需要账号级凭据，Access Token
# 可能权限不够——可额外配置 DOCKERHUB_PASSWORD，存在时优先使用。
# 使用前请核对 Action 的版本号是否为当前最新主版本。

name: Docker Hub Description

on:
  push:
    branches: [{{DEFAULT_BRANCH}}]
    paths:
      - {{HUB_README_PATH}}
      - .github/workflows/dockerhub-description.yml
  workflow_dispatch:

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - uses: peter-evans/dockerhub-description@v5
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_PASSWORD || secrets.DOCKERHUB_TOKEN }}
          repository: {{HUB_IMAGE}}
          readme-filepath: ./{{HUB_README_PATH}}
          short-description: "{{HUB_SHORT_DESCRIPTION}}"
