# Docker Hub 发布 workflow。
#
# 触发方式：仅 `v*.*.*` 格式的 tag push（分支推送不触发构建）。
# 所需 secrets：DOCKERHUB_USERNAME、DOCKERHUB_TOKEN（Docker Hub Access Token，Read & Write 权限）。
# 版本真源：{{VERSION_SOURCE}} —— tag 必须等于 `v` + 该版本号，安装脚本里的版本号也必须一致，不等直接失败。
# 使用前请核对各 Action 的版本号是否为当前最新主版本。

name: Docker Publish

on:
  push:
    tags:
      - 'v*.*.*'

permissions:
  contents: read

env:
  IMAGE_NAME: {{HUB_IMAGE}}

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - name: ShellCheck 部署管理脚本
        run: shellcheck {{SCRIPT_REPO_PATH}}

      - name: 校验 tag、版本真源、安装脚本三处版本一致
        run: |
          TAG_VERSION="${GITHUB_REF_NAME#v}"
          SRC_VERSION=$({{VERSION_READ_CMD}})
          SCRIPT_VERSION=$(sed -n 's/^SCRIPT_VERSION="\(.*\)"$/\1/p' {{SCRIPT_REPO_PATH}})
          for pair in "版本真源:$SRC_VERSION" "安装脚本:$SCRIPT_VERSION"; do
            if [ "${pair#*:}" != "$TAG_VERSION" ]; then
              echo "::error::tag ${GITHUB_REF_NAME} 与${pair%%:*}的版本 ${pair#*:} 不一致"
              exit 1
            fi
          done

      - name: 校验内嵌 compose 模板与仓库文件逐字节一致
        run: |
          {{APP_ENV_PREFIX}}_SOURCE_ONLY=1 {{APP_ENV_PREFIX}}_TTY=- bash -c '. {{SCRIPT_REPO_PATH}}; tpl_compose' </dev/null \
            | diff - {{COMPOSE_REPO_PATH}}

      # ---- 在这里加入安装脚本的冒烟测试，以及项目自己的 lint / 类型检查 / 测试步骤 ----

  publish:
    needs: verify
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      # 正式版同时推 latest；预发布版本（版本号含 -，如 1.2.0-rc.1）只推自身版本号
      - name: 计算镜像 tags
        id: tags
        run: |
          VERSION="${GITHUB_REF_NAME#v}"
          {
            echo "list<<EOF"
            echo "${IMAGE_NAME}:${VERSION}"
            if [[ "$VERSION" != *-* ]]; then
              echo "${IMAGE_NAME}:latest"
            fi
            echo "EOF"
          } >> "$GITHUB_OUTPUT"

      # 构建多架构镜像时需要（仅 linux/amd64 时可删去本步）
      - uses: docker/setup-qemu-action@v4

      - uses: docker/setup-buildx-action@v4

      - uses: docker/login-action@v4
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - uses: docker/build-push-action@v7
        with:
          context: .
          platforms: {{TARGET_PLATFORMS}}
          push: true
          tags: ${{ steps.tags.outputs.list }}
          # 关闭构建来源证明：否则每个 tag 下会多出一个 unknown/unknown 架构条目，容易让用户困惑
          provenance: false
          # 用 GitHub Actions 自带的缓存加速重复构建
          cache-from: type=gha
          cache-to: type=gha,mode=max
