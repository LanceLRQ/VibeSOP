# {{PROJECT_SLUG}} — 构建并推送镜像
# 只负责构建与推送；部署仍由人在服务器上执行拉取与重启（有意保留的人工闸门）。
# 需要在仓库 Settings → Secrets 中配置：REGISTRY_USERNAME、REGISTRY_PASSWORD
# 使用前请核对各 Action 的版本号是否为当前最新主版本。

name: build-images

on:
  push:
    tags: ["v*"]
  workflow_dispatch:

env:
  REGISTRY: {{REGISTRY_PUBLIC}}
  NAMESPACE: {{REGISTRY_NAMESPACE}}

jobs:
  build:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        service: [{{SERVICES_CSV}}]
    steps:
      - uses: actions/checkout@v7

      - uses: docker/setup-buildx-action@v4

      - uses: docker/login-action@v4
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ secrets.REGISTRY_USERNAME }}
          password: ${{ secrets.REGISTRY_PASSWORD }}

      - uses: docker/build-push-action@v7
        with:
          context: .
          file: {{DEPLOY_DIR}}/prod/${{ matrix.service }}/Dockerfile
          platforms: {{TARGET_PLATFORM}}
          push: true
          build-args: |
            VERSION=${{ github.ref_name }}
          tags: |
            ${{ env.REGISTRY }}/${{ env.NAMESPACE }}/{{PROJECT_SLUG}}-${{ matrix.service }}:${{ github.ref_name }}
            ${{ env.REGISTRY }}/${{ env.NAMESPACE }}/{{PROJECT_SLUG}}-${{ matrix.service }}:latest
