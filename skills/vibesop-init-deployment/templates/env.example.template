# {{PROJECT_SLUG}} 构建与运维变量
# 复制为 .env 后填写。.env 不入库；本文件只保留变量名与说明，不写真实值。
# 应用自身的运行时配置不放这里（见部署 README）。

# >>> REGISTRY
# ============================================
# 镜像仓库凭证（阿里云 ACR）
# ============================================
# 用户名与固定密码见 ACR 控制台「访问凭证」，不是阿里云账号的登录密码
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
REGISTRY_NAMESPACE={{REGISTRY_NAMESPACE}}
# 服务器与 ACR 同地域且在 VPC 内时设为 vpc，走内网拉取；其余情况留 public
REGISTRY_NET=public
# <<< REGISTRY

# >>> DB
# ============================================
# 数据库迁移连接串（供宿主机上的迁移工具使用）
# ============================================
# 密码见密钥目录下的 app_password.txt
DATABASE_URL=
# <<< DB

# ============================================
# 构建期变量
# ============================================
# 这里的值会在构建镜像时写进产物：浏览器可见，只能放公开值；改值后必须重新构建镜像。
